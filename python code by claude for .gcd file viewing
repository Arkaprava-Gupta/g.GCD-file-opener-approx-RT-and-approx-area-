#  ZOOM / PAN CONTROLLER  (x-axis shared, y per subplot)
# ════════════════════════════════════════════════════════════════════════════════

class ZoomPanController:
    ZOOM = 1.3

    def __init__(self, fig, axes, canvas):
        self.fig    = fig
        self.axes   = list(axes)
        self.canvas = canvas
        self._rect  = None
        self._press = None
        self._mode  = None
        self._xhome = None
        self._yhome = None
        self._connect()

    def set_home(self):
        if self.axes:
            self._xhome = list(self.axes[0].get_xlim())
            self._yhome = [list(ax.get_ylim()) for ax in self.axes]

    def reset(self):
        if self._xhome and self.axes:
            for ax, yh in zip(self.axes, self._yhome or []):
                ax.set_xlim(self._xhome)
                ax.set_ylim(yh)
            self.canvas.draw_idle()

    def zoom_y(self, ax_index, factor):
        """
        Zoom the Y axis of a subplot.
        Anchors at the signal baseline (bottom 5% of current view) so that
        zooming IN makes peaks grow taller upward — not disappear downward.
        factor < 1  = zoom in  (peaks taller)
        factor > 1  = zoom out (more range visible)
        """
        if ax_index >= len(self.axes):
            return
        ax     = self.axes[ax_index]
        lo, hi = ax.get_ylim()
        span   = hi - lo

        # anchor point: keep the bottom 10% of the view fixed
        # so the baseline stays in place and peaks grow upward
        anchor = lo + span * 0.10
        new_span = span * factor
        new_lo   = anchor - new_span * 0.10
        new_hi   = anchor + new_span * 0.90
        ax.set_ylim(new_lo, new_hi)
        self.canvas.draw_idle()

    def _connect(self):
        c = self.canvas
        c.mpl_connect("scroll_event",         self._scroll)
        c.mpl_connect("button_press_event",   self._press_ev)
        c.mpl_connect("motion_notify_event",  self._motion)
        c.mpl_connect("button_release_event", self._release)

    def _ctrl(self, event):
        try:
            return bool(event.guiEvent.state & 4)
        except Exception:
            return str(event.key or "").lower().startswith("ctrl")

    def _scroll(self, event):
        if event.inaxes not in self.axes:
            return
        f = 1 / self.ZOOM if event.step > 0 else self.ZOOM
        if self._ctrl(event):
            # sync x-zoom across all subplots
            cx = event.xdata or sum(self.axes[0].get_xlim()) / 2
            for ax in self.axes:
                lo, hi = ax.get_xlim()
                ax.set_xlim(cx + (lo - cx) * f, cx + (hi - cx) * f)
        else:
            # y-zoom only on the hovered axis
            ax = event.inaxes
            cy = event.ydata or sum(ax.get_ylim()) / 2
            lo, hi = ax.get_ylim()
            ax.set_ylim(cy + (lo - cy) * f, cy + (hi - cy) * f)
        self.canvas.draw_idle()

    def _press_ev(self, event):
        if event.inaxes not in self.axes:
            return
        if event.dblclick:
            self.reset(); return
        if event.button == 1:
            self._mode  = "zoom"
            self._press = (event.xdata, event.ydata, event.inaxes)
            self._rect  = Rectangle(
                (event.xdata, event.ydata), 0, 0,
                lw=1.4, edgecolor=ACCENT,
                facecolor=ACCENT, alpha=0.12,
                transform=event.inaxes.transData)
            event.inaxes.add_patch(self._rect)
            self.canvas.draw_idle()
        elif event.button == 2:
            ax0 = event.inaxes
            # store press in PIXEL coords — stable regardless of subsequent limit changes
            self._mode  = "pan"
            self._press = {
                "px"   : event.x,           # pixel x at press
                "py"   : event.y,            # pixel y at press
                "ax"   : ax0,
                "xlim" : list(ax0.get_xlim()),
                "ylim" : list(ax0.get_ylim()),
            }

    def _motion(self, event):
        if not self._press:
            return
        if self._mode == "zoom" and self._rect:
            if not event.xdata or not event.ydata:
                return
            x0, y0, _ = self._press
            self._rect.set_width(event.xdata - x0)
            self._rect.set_height(event.ydata - y0)
            self._rect.set_xy((x0, y0))
            self.canvas.draw_idle()
        elif self._mode == "pan":
            ax0  = self._press["ax"]
            xlim = self._press["xlim"]
            ylim = self._press["ylim"]

            # pixel delta since press
            dpx = event.x - self._press["px"]
            dpy = event.y - self._press["py"]

            # convert pixel delta → data delta using ORIGINAL limits + axis bbox
            bbox  = ax0.get_window_extent()
            if bbox.width == 0 or bbox.height == 0:
                return
            x_range = xlim[1] - xlim[0]
            y_range = ylim[1] - ylim[0]
            dx = dpx * x_range / bbox.width
            dy = dpy * y_range / bbox.height

            # apply: subtract dx/dy so the point under the cursor stays fixed
            ax0.set_xlim(xlim[0] - dx, xlim[1] - dx)
            ax0.set_ylim(ylim[0] - dy, ylim[1] - dy)
            self.canvas.draw_idle()

    def _release(self, event):
        if self._mode == "zoom" and self._press:
            x0, y0, ax0 = self._press
            if event.xdata and event.ydata:
                x1, y1 = event.xdata, event.ydata
                if abs(x1 - x0) > 1e-6 and abs(y1 - y0) > 1:
                    xlo, xhi = sorted([x0, x1])
                    for ax in self.axes:
                        ax.set_xlim(xlo, xhi)
                    ax0.set_ylim(sorted([y0, y1]))
            if self._rect:
                try:    self._rect.remove()
                except: pass
                self._rect = None
        self._mode  = None
        self._press = None
        self.canvas.draw_idle()


