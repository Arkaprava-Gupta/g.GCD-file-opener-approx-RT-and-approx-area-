    # ── empty state ───────────────────────────────────────────────────────────

    def _draw_empty(self):
        self.fig.clear()
        ax = self.fig.add_subplot(111)
        ax.set_facecolor(PLOT_BG)
        ax.text(0.5, 0.54, "Open a  .gcd  file  to  begin",
                ha="center", va="center", fontsize=13,
                color="#334155", fontfamily="Segoe UI",
                transform=ax.transAxes)
        ax.text(0.5, 0.45, "Use the  ⊕ Open .GCD  button above",
                ha="center", va="center", fontsize=9,
                color="#1E293B", fontfamily="Segoe UI",
                transform=ax.transAxes)
        for sp in ax.spines.values():
            sp.set_visible(False)
        ax.set_xticks([]); ax.set_yticks([])
        self.canvas.draw()

    # ── file open ─────────────────────────────────────────────────────────────

    def _open_file(self, path=None):
        if path is None:
            path = filedialog.askopenfilename(
                title="Open Shimadzu .gcd file",
                filetypes=[("GCD files", "*.gcd"), ("All files", "*.*")])
        if not path:
            return
        self.status_var.set(f"Loading  {Path(path).name} …")
        self.root.update()
        # run heavy IO + peak detection in background thread
        import threading
        def _load():
            try:
                data = read_gcd(path)
                self.root.after(0, lambda: self._on_loaded(data, path))
            except Exception as e:
                self.root.after(0, lambda: self._on_load_error(str(e)))
        threading.Thread(target=_load, daemon=True).start()

    def _on_loaded(self, data, path):
        self.data = data
        self._rebuild_channel_checkboxes()
        self._rebuild_peak_tables()
        self._refresh_plot()
        self._update_info()
        self.file_label.config(text=Path(path).name, fg=ACCENT)
        d    = self.data
        n_pk = sum(len(c["peaks"]) for c in d["channels"])
        self.status_var.set(
            f"{Path(path).name}  ·  {d['n_points']:,} pts  ·  "
            f"{d['run_time_min']:.3f} min  ·  "
            f"{len(d['channels'])} channels  ·  {n_pk} peaks")

    def _on_load_error(self, msg):
        messagebox.showerror("Parse Error", msg)
        self.status_var.set("Error loading file")

    # ── channel checkboxes ────────────────────────────────────────────────────

    def _rebuild_channel_checkboxes(self):
        for w in self.ch_frame.winfo_children():
            w.destroy()
        self._ch_vars = []
        for i, ch in enumerate(self.data["channels"]):
            col = CH_COLORS[i % len(CH_COLORS)]
            var = tk.BooleanVar(value=True)
            self._ch_vars.append(var)
            f = tk.Frame(self.ch_frame, bg=SIDEBAR)
            f.pack(fill="x", pady=2)
            tk.Label(f, text="●", font=("Segoe UI", 11),
                     fg=col, bg=SIDEBAR).pack(side="left", padx=(4, 2))
            tk.Checkbutton(f,
                           text=f"{ch['label']}  ({len(ch['peaks'])} peaks)",
                           variable=var,
                           font=FONT, fg=TEXT, bg=SIDEBAR,
                           selectcolor=ITEM_BG, activebackground=SIDEBAR,
                           activeforeground=TEXT, bd=0,
                           command=self._refresh_plot).pack(side="left")

    # ── info sidebar ──────────────────────────────────────────────────────────

    def _update_info(self):
        d    = self.data
        name = Path(d["filepath"]).name
        self._info_rows["File"].config(
            text=(name[:21] + "…") if len(name) > 21 else name)
        self._info_rows["Run time"].config(
            text=f"{d['run_time_min']:.3f} min")
        self._info_rows["Points"].config(text=f"{d['n_points']:,}")
        self._info_rows["dt"].config(text=f"{d['dt_ms']:.2f} ms")
        self._info_rows["Channels"].config(
            text=str(len(d["channels"])))

    # ── peak tables ───────────────────────────────────────────────────────────

    def _rebuild_peak_tables(self):
        for tab in self.nb.tabs():
            self.nb.forget(tab)
        self._peak_tables = {}
        COLS   = ("#", "RT (min)", "Area (µV·s)", "Height (µV)",
                  "Start (min)", "End (min)")
        WIDTHS = (35, 90, 130, 120, 100, 100)
        for ch in self.data["channels"]:
            frame = tk.Frame(self.nb, bg=PANEL)
            self.nb.add(frame, text=f"  {ch['label']}  ")
            tv = ttk.Treeview(frame, columns=COLS, show="headings",
                              selectmode="browse")
            for c, w in zip(COLS, WIDTHS):
                tv.heading(c, text=c)
                tv.column(c, width=w, anchor="center")
            sb2 = ttk.Scrollbar(frame, orient="vertical", command=tv.yview)
            tv.configure(yscrollcommand=sb2.set)
            tv.pack(side="left", fill="both", expand=True)
            sb2.pack(side="right", fill="y")
            self._peak_tables[ch["label"]] = tv
        self._fill_peak_tables()

    def _fill_peak_tables(self):
        if not self.data:
            return
        for ch in self.data["channels"]:
            tv = self._peak_tables.get(ch["label"])
            if not tv:
                continue
            for row in tv.get_children():
                tv.delete(row)
            for i, p in enumerate(ch["peaks"], 1):
                tv.insert("", "end", values=(
                    i,
                    f"{p['rt_min']:.4f}",
                    f"{p['area']:,.1f}",
                    f"{p['height']:,.1f}",
                    f"{p['start_min']:.4f}",
                    f"{p['end_min']:.4f}",
                ))

    # ── plot ──────────────────────────────────────────────────────────────────

    def _refresh_plot(self):
        if not self.data:
            return
        d       = self.data
        stacked = self.layout_var.get() == "stacked"
        ann_on  = self.show_peaks.get()
        area_on = self.show_areas.get()

        visible = [i for i, v in enumerate(self._ch_vars) if v.get()]
        if not visible:
            self._draw_empty()
            return

        self.fig.clear()
        n_vis = len(visible) if stacked else 1
        if stacked and n_vis > 1:
            axes = list(self.fig.subplots(n_vis, 1, sharex=False))
        else:
            axes = [self.fig.add_subplot(111)]
        self._ax_list = axes

        ax_idx = 0
        zoom_bar_entries = []   # (label, ax_index, color)

        for i, ch in enumerate(d["channels"]):
            if i not in visible:
                continue
            col = CH_COLORS[i % len(CH_COLORS)]
            ax  = axes[ax_idx] if stacked else axes[0]
            t   = ch["time"]
            sig = ch["signal"]

            # downsample for display only (keeps rendering fast)
            # max 6000 pts on screen — full data is kept in ch["signal"] for export
            MAX_PTS = 6000
            if len(t) > MAX_PTS:
                stride = len(t) // MAX_PTS
                t_plot   = t[::stride]
                sig_plot = sig[::stride]
            else:
                t_plot, sig_plot = t, sig

            ax.set_facecolor(PLOT_BG)
            ax.plot(t_plot, sig_plot, color=col, linewidth=0.85,
                    label=ch["label"], zorder=3)

            # set tight ylim: baseline just below signal min, top 8% headroom
            # this ensures zoom_y anchors at the real signal floor, not empty space
            sig_min = float(sig.min())
            sig_max = float(sig.max())
            sig_range = sig_max - sig_min or 1.0
            ax.set_ylim(sig_min - sig_range * 0.05,
                        sig_max + sig_range * 0.08)

            # shade areas
            if area_on:
                for p in ch["peaks"]:
                    l = p["l_idx"]; r = p["r_idx"]
                    l = int(np.clip(l, 0, len(sig)-1))
                    r = int(np.clip(r, 0, len(sig)-1))
                    if r > l:
                        bl = np.linspace(sig[l], sig[r], r - l + 1)
                        ax.fill_between(t[l:r+1], sig[l:r+1], bl,
                                        alpha=0.18, color=col, zorder=2)

            # RT annotations
            if ann_on:
                for p in ch["peaks"]:
                    idx = int(np.clip(p["peak_idx"], 0, len(sig)-1))
                    ax.annotate(
                        f"{p['rt_min']:.3f}",
                        xy=(t[idx], sig[idx]),
                        xytext=(0, 10), textcoords="offset points",
                        ha="center", fontsize=6.5,
                        color="#FCD34D",
                        fontfamily="Segoe UI",
                        fontweight="bold",
                        rotation=55,
                        arrowprops=dict(arrowstyle="->",
                                        color="#FCD34D", lw=0.55),
                        clip_on=True, zorder=5,
                    )

            ax.set_ylabel("Signal  (µV)", color="#64748B", fontsize=8,
                          fontfamily="Segoe UI")
            ax.legend(loc="upper right",
                      facecolor="#0D0D1F", edgecolor=GRID_COL,
                      labelcolor=col, fontsize=8,
                      prop={"family": "Segoe UI"})
            ax.tick_params(colors="#475569", labelsize=7.5,
                           length=3, width=0.7)
            for sp in ax.spines.values():
                sp.set_edgecolor(GRID_COL); sp.set_linewidth(0.5)
            ax.xaxis.set_minor_locator(ticker.AutoMinorLocator())
            ax.yaxis.set_minor_locator(ticker.AutoMinorLocator())
            ax.grid(True, color=GRID_COL, lw=0.5, alpha=0.9, zorder=0)
            ax.grid(True, which="minor", color="#0E0E1C", lw=0.3, zorder=0)

            zoom_bar_entries.append((ch["label"], ax_idx, col))
            if stacked:
                ax_idx += 1

        axes[-1].set_xlabel("Retention Time  (min)",
                             color="#64748B", fontsize=8,
                             fontfamily="Segoe UI")
        fname = Path(d["filepath"]).name
        self.fig.suptitle(fname, color="#94A3B8", fontsize=9.5,
                          fontfamily="Segoe UI", fontweight="bold", y=0.999)
        self.fig.tight_layout(rect=[0, 0, 1, 0.999])
        self.canvas.draw()

        # set up zoom/pan controller
        self._zpc = ZoomPanController(self.fig, self._ax_list, self.canvas)
        self._zpc.set_home()

        # rebuild per-channel zoom bar
        self.zoom_bar.set_controller(self._zpc)
        self.zoom_bar.rebuild(zoom_bar_entries)

    def _reset_zoom(self):
        if self._zpc:
            self._zpc.reset()

    # ── export ────────────────────────────────────────────────────────────────

    def _export_menu(self):
        if not self.data:
            messagebox.showinfo("Nothing to export",
                                "Load a .gcd file first.")
            return
        win = tk.Toplevel(self.root)
        win.title("Export Data")
        win.configure(bg=PANEL)
        win.geometry("390x315")
        win.resizable(False, False)

        tk.Label(win, text="Export Options",
                 font=("Segoe UI", 12, "bold"),
                 fg=TEXT, bg=PANEL).pack(pady=(20, 10))

        for lbl, cmd in [
            ("Raw Signal  →  CSV  (Origin-ready)",  self._export_signal_csv),
            ("Raw Signal  →  Excel  (.xlsx)",        self._export_signal_xlsx),
            ("Peak Table  →  CSV",                   self._export_peaks_csv),
            ("Peak Table  →  Excel  (.xlsx)",        self._export_peaks_xlsx),
        ]:
            c = cmd
            _flat_btn(win, lbl, lambda fn=c: [win.destroy(), fn()],
                      bg=ACCENT, fg=TEXT, padx=0, pady=8, width=38
                      ).pack(pady=3, padx=22, fill="x")

        _flat_btn(win, "Cancel", win.destroy,
                  bg=ITEM_BG, fg=DIM, pady=6
                  ).pack(pady=(8, 4), padx=22, fill="x")

    def _export_signal_csv(self):
        d    = self.data
        stem = Path(d["filepath"]).stem
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            initialfile=f"{stem}_signal.csv",
            filetypes=[("CSV", "*.csv")])
        if not path:
            return
        chs = d["channels"]
        n   = max(len(c["time"]) for c in chs)
        with open(path, "w", newline="") as f:
            w = csv.writer(f)
            w.writerow(["Time_min"] + [f"{c['label']}_uV" for c in chs])
            for i in range(n):
                row = []
                for ci, c in enumerate(chs):
                    if i < len(c["time"]):
                        if ci == 0: row.append(f"{c['time'][i]:.6f}")
                        row.append(f"{c['signal'][i]:.4f}")
                    else:
                        if ci == 0: row.append("")
                        row.append("")
                w.writerow(row)
        self.status_var.set(f"Exported → {path}")
        messagebox.showinfo("Exported",
            f"Signal saved to:\n{path}\n\nFormat: Time_min | Ch1_uV | Ch2_uV …\n"
            "Ready to import into Origin / Excel.")

    def _export_signal_xlsx(self):
        try:
            import openpyxl
        except ImportError:
            messagebox.showerror("Missing", "Run:  pip install openpyxl")
            return
        d    = self.data
        stem = Path(d["filepath"]).stem
        path = filedialog.asksaveasfilename(
            defaultextension=".xlsx",
            initialfile=f"{stem}_signal.xlsx",
            filetypes=[("Excel", "*.xlsx")])
        if not path:
            return
        wb = openpyxl.Workbook()
        for ch in d["channels"]:
            ws = wb.create_sheet(title=ch["label"][:31])
            ws.append(["Time_min", f"{ch['label']}_uV"])
            for t, s in zip(ch["time"], ch["signal"]):
                ws.append([round(float(t), 6), round(float(s), 4)])
        if "Sheet" in wb.sheetnames:
            del wb["Sheet"]
        wb.save(path)
        self.status_var.set(f"Exported → {path}")
        messagebox.showinfo("Exported",
            f"Signal saved to:\n{path}\n\nOne sheet per detector channel.")

    def _export_peaks_csv(self):
        d    = self.data
        stem = Path(d["filepath"]).stem
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            initialfile=f"{stem}_peaks.csv",
            filetypes=[("CSV", "*.csv")])
        if not path:
            return
        with open(path, "w", newline="") as f:
            w = csv.writer(f)
            w.writerow(["Channel", "Peak#", "RT_min",
                        "Area_uVs", "Height_uV",
                        "Start_min", "End_min"])
            for ch in d["channels"]:
                for i, p in enumerate(ch["peaks"], 1):
                    w.writerow([
                        ch["label"], i,
                        f"{p['rt_min']:.4f}",
                        f"{p['area']:.2f}",
                        f"{p['height']:.2f}",
                        f"{p['start_min']:.4f}",
                        f"{p['end_min']:.4f}",
                    ])
        self.status_var.set(f"Exported → {path}")
        messagebox.showinfo("Exported", f"Peak table saved to:\n{path}")

    def _export_peaks_xlsx(self):
        try:
            import openpyxl
        except ImportError:
            messagebox.showerror("Missing", "Run:  pip install openpyxl")
            return
        d    = self.data
        stem = Path(d["filepath"]).stem
        path = filedialog.asksaveasfilename(
            defaultextension=".xlsx",
            initialfile=f"{stem}_peaks.xlsx",
            filetypes=[("Excel", "*.xlsx")])
        if not path:
            return
        wb = openpyxl.Workbook()
        for ch in d["channels"]:
            ws = wb.create_sheet(title=ch["label"][:31])
            ws.append(["Peak#", "RT_min", "Area_uVs",
                       "Height_uV", "Start_min", "End_min"])
            for i, p in enumerate(ch["peaks"], 1):
                ws.append([
                    i,
                    round(p["rt_min"],    4),
                    round(p["area"],      2),
                    round(p["height"],    2),
                    round(p["start_min"], 4),
                    round(p["end_min"],   4),
                ])
        if "Sheet" in wb.sheetnames:
            del wb["Sheet"]
        wb.save(path)
        self.status_var.set(f"Exported → {path}")
        messagebox.showinfo("Exported", f"Peak table saved to:\n{path}")

    def _save_png(self):
        if not self.data:
            messagebox.showinfo("Nothing to save", "Load a .gcd file first.")
            return
        default = Path(self.data["filepath"]).stem + "_chromatogram.png"
        path = filedialog.asksaveasfilename(
            defaultextension=".png", initialfile=default,
            filetypes=[("PNG image", "*.png"), ("All files", "*.*")])
        if path:
            self.fig.savefig(path, dpi=180, bbox_inches="tight",
                             facecolor=self.fig.get_facecolor())
            self.status_var.set(f"Saved PNG → {path}")
            messagebox.showinfo("Saved", f"Plot saved to:\n{path}")


