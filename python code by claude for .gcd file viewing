    def _build_peak_table_container(self):
        self.nb = ttk.Notebook(self.table_frame)
        self.nb.pack(fill="both", expand=True)

        s = ttk.Style()
        s.theme_use("clam")
        s.configure("TNotebook",         background=PANEL,    borderwidth=0)
        s.configure("TNotebook.Tab",     background=ITEM_BG,  foreground=DIM,
                    font=FONT_B, padding=[14, 4])
        s.map("TNotebook.Tab",           background=[("selected", PANEL)],
                                         foreground=[("selected", TEXT)])
