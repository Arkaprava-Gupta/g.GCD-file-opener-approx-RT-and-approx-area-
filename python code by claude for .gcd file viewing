def main():
    root = tk.Tk()
    app  = GCDViewerApp(root)
    if len(sys.argv) > 1 and Path(sys.argv[1]).exists():
        root.after(200, lambda: app._open_file(sys.argv[1]))
    root.mainloop()

if __name__ == "__main__":
    main()
