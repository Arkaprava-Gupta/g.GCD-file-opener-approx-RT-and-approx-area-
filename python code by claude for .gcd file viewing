#  PER-CHANNEL Y-ZOOM TOOLBAR  (appears above the plot canvas)
# ════════════════════════════════════════════════════════════════════════════════

class ChannelZoomBar(tk.Frame):
    """
    Horizontal bar shown above the plot.
    One pair of  🔍+  🔍-  buttons per visible channel.
    Clicking them zooms the Y-axis of that channel's subplot
    so smaller peaks appear taller — amplitude zoom.
    """
    YZOOM_IN  = 0.6    # multiply (lo,hi) span by this → zoom in  (peaks taller)
    YZOOM_OUT = 1 / 0.6

    def __init__(self, parent, **kw):
        super().__init__(parent, bg=PANEL, **kw)
        self._zpc      = None   # ZoomPanController reference
        self._entries  = []     # list of (label, ax_index, color)

    def set_controller(self, zpc):
        self._zpc = zpc

    def rebuild(self, channels_visible):
        """
        channels_visible: list of (label, ax_index, color)
        ax_index is the index into ZoomPanController.axes
        """
        for w in self.winfo_children():
            w.destroy()
        self._entries = channels_visible

        tk.Label(self, text="Amplitude Zoom:", font=("Segoe UI", 8),
                 fg=DIM, bg=PANEL).pack(side="left", padx=(10, 6))

        for label, ax_idx, color in channels_visible:
            grp = tk.Frame(self, bg=PANEL)
            grp.pack(side="left", padx=6)

            tk.Label(grp, text=f"● {label}",
                     font=("Segoe UI", 8, "bold"),
                     fg=color, bg=PANEL).pack(side="left", padx=(0, 4))

            # zoom-in button
            zi = tk.Button(grp, text="🔍+",
                           font=("Segoe UI", 9),
                           bg="#1A1A2E", fg="#FFD700",
                           activebackground="#252545",
                           activeforeground="#FFD700",
                           relief="flat", bd=0, cursor="hand2",
                           padx=6, pady=2,
                           command=lambda i=ax_idx: self._zy(i, self.YZOOM_IN))
            zi.pack(side="left")

            # zoom-out button
            zo = tk.Button(grp, text="🔍–",
                           font=("Segoe UI", 9),
                           bg="#1A1A2E", fg="#94A3B8",
                           activebackground="#252545",
                           activeforeground="#CBD5E1",
                           relief="flat", bd=0, cursor="hand2",
                           padx=6, pady=2,
                           command=lambda i=ax_idx: self._zy(i, self.YZOOM_OUT))
            zo.pack(side="left", padx=(0, 2))

        # spacer + reset-y button
        tk.Label(self, text="|", fg=BORDER, bg=PANEL,
                 font=FONT).pack(side="left", padx=4)
        tk.Button(self, text="↺ Reset Y",
                  font=("Segoe UI", 8),
                  bg="#1A1A2E", fg=DIM,
                  activebackground="#252545", activeforeground=TEXT,
                  relief="flat", bd=0, cursor="hand2",
                  padx=8, pady=2,
                  command=self._reset_y).pack(side="left", padx=2)

    def _zy(self, ax_index, factor):
        if self._zpc:
            self._zpc.zoom_y(ax_index, factor)

    def _reset_y(self):
        if self._zpc:
            self._zpc.reset()


