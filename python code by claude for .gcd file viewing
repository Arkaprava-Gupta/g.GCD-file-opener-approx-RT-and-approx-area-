                    fieldbackground=ITEM_BG, font=FONT_S,
                    rowheight=19, borderwidth=0)
        s.configure("Treeview.Heading",  background=PANEL,    foreground=DIM,
                    font=FONT_B, relief="flat")
        s.map("Treeview",                background=[("selected", "#1E3A5F")],
                                         foreground=[("selected", TEXT)])
