def _flat_btn(parent, text, cmd, bg=ACCENT, fg=TEXT,
              font=FONT_B, padx=12, pady=5, **kw):
    b = tk.Button(parent, text=text, command=cmd,
                  font=font, bg=bg, fg=fg,
                  activebackground=ACCENT_H, activeforeground=TEXT,
                  relief="flat", bd=0, cursor="hand2",
                  padx=padx, pady=pady, **kw)
    return b


def _section_label(parent, text):
    f = tk.Frame(parent, bg=SIDEBAR)
    f.pack(fill="x", pady=(14, 2))
    tk.Label(f, text=text.upper(), font=("Segoe UI", 7, "bold"),
             fg=DIM, bg=SIDEBAR).pack(anchor="w", padx=16)
    tk.Frame(parent, bg=BORDER, height=1).pack(fill="x", padx=10)


