def _decode_signal(raw, header=40):
    avail = (len(raw) - header) // 8 * 8
    return np.frombuffer(raw[header : header + avail], dtype="<f8").copy()


def _discover_channels(ole):
    all_paths = ["/".join(s) for s in ole.listdir()]
    raw_re    = re.compile(r"LSS Raw Data/Chromatogram Ch(\d+)$", re.IGNORECASE)
    return sorted(
        [p for p in all_paths if raw_re.match(p) and ole.get_size(p) > 200],
        key=lambda p: int(raw_re.match(p).group(1))
    )


def _detect_peaks(sig, time, dt_ms):
    from scipy.signal import find_peaks, peak_widths
    dist_pts   = max(2, int(80 / dt_ms))
    idx, props = find_peaks(sig, prominence=100, distance=dist_pts)
    if len(idx) == 0:
        return []
    _, _, lips, rips = peak_widths(sig, idx, rel_height=0.999)
    peaks = []
    for i, p in enumerate(idx):
        l  = max(0, int(np.floor(lips[i])))
        r  = min(len(sig) - 1, int(np.ceil(rips[i])))
        bl = np.linspace(sig[l], sig[r], r - l + 1)
        area   = float(np.trapezoid(sig[l:r+1] - bl, time[l:r+1])) * 60.0
        height = float(props["prominences"][i])
        peaks.append({
            "rt_min"    : float(time[p]),
            "area"      : max(0.0, area),
            "height"    : height,
            "start_min" : float(time[l]),
            "end_min"   : float(time[r]),
            "peak_idx"  : int(p),
            "l_idx"     : l,
            "r_idx"     : r,
        })
    return peaks


def read_gcd(filepath):
    ole = olefile.OleFileIO(filepath)

    status_paths = ["/".join(s) for s in ole.listdir()
                    if "chromatogram status" in s[-1].lower()
                    and ole.get_size("/".join(s)) > 0]
    if not status_paths:
        raise ValueError("No 'Chromatogram Status' stream — not a valid .gcd file.")
    status_raw = ole.openstream(status_paths[0]).read()

    ch_paths = _discover_channels(ole)
    if not ch_paths:
        raise ValueError("No chromatogram channels found.")

    raw0     = ole.openstream(ch_paths[0]).read()
    n_points = struct.unpack_from("<i", raw0, 8)[0]
    total_ms = struct.unpack_from("<i", status_raw, 8)[0]
    dt_ms    = total_ms / n_points

    raw_re = re.compile(r"LSS Raw Data/Chromatogram Ch(\d+)$", re.IGNORECASE)
    channels = []
    for path in ch_paths:
        raw    = ole.openstream(path).read()
        signal = _decode_signal(raw)
        n      = min(len(signal), n_points)
        time   = np.arange(n) * dt_ms / 60_000.0
        signal = signal[:n]
        ch_num = raw_re.match(path).group(1)
        peaks  = _detect_peaks(signal, time, dt_ms)
        channels.append({
            "label"  : f"Ch{ch_num}",
            "time"   : time,
            "signal" : signal,
            "peaks"  : peaks,
        })

    ole.close()
    return {
        "filepath"    : filepath,
        "n_points"    : n_points,
        "run_time_min": total_ms / 60_000.0,
        "dt_ms"       : dt_ms,
        "channels"    : channels,
    }


